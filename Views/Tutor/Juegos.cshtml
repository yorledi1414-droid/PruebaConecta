@{
    ViewBag.Title = "Juegos Educativos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/Content/Juegos.css" />
}

<div class="juegos-container">

    <!-- ENCABEZADO -->
    <div class="header-box">
        <a href="@Url.Action("TutorVista", "Tutor")" class="back-btn">← Volver al Dashboard</a>

        <div class="header-top">
            <div>
                <h1>Juegos Educativos</h1>
                <p>Aprende jugando</p>
            </div>

            <div class="points-box">
                🏆 <span>0 puntos</span>
            </div>
        </div>
    </div>

    <!-- GRID DE JUEGOS -->
    <div class="juegos-grid">

        <!-- JUEGO 1 -->
        <a href="@Url.Action("JuegoDeMemoria", "Tutor")" class="juego-card purple" style="text-decoration:none; color:inherit;">
            <div class="icon-circle purple-bg">
                <i class="fas fa-brain"></i>
            </div>
            <h3>Juego de Memoria</h3>
            <p class="desc">Encuentra las parejas y mejora tu memoria</p>
            <p class="points">10 puntos por pareja encontrada</p>
        </a>

        <!-- JUEGO 2 -->
        <a href="@Url.Action("Rompecabezas", "Tutor")" class="juego-card green" style="text-decoration:none; color:inherit;">
            <div class="icon-circle green-bg">
                <i class="fas fa-puzzle-piece"></i>
            </div>
            <h3>Rompecabezas</h3>
            <p class="desc">Completa el rompecabezas arrastrando las piezas</p>
            <p class="points">50 puntos por rompecabezas completado</p>
        </a>

    </div>
</div>
