@{
    ViewBag.Title = "Registrar Progreso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/Content/ResgistrarProgreso.css" />
}

<div class="reg-wrapper">

    <!-- VOLVER -->
    <a href="@Url.Action("TerapeutaVista", "Terapeuta")" class="btn-back">
        ← Volver al Dashboard
    </a>

    <!-- TITULO -->
    <div class="title-box">
        <h1>Registrar Progreso</h1>
        <p>Documenta las sesiones y el avance de tus pacientes</p>
    </div>

    <div class="layout-grid">

        <!-- FORMULARIO -->
        <div class="form-card">

            <h2>Nueva Sesión</h2>
            <p class="desc">Completa la información de la sesión realizada</p>

            <div class="form-grid">

                <div class="form-group">
                    <label>Paciente *</label>
                    <select>
                        <option>Selecciona un paciente</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Juego/Actividad *</label>
                    <select>
                        <option>Selecciona un juego</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Fecha de la Sesión</label>
                    <div class="input-icon">
                        <i class="fas fa-calendar"></i>
                        <input type="text" value="13 de noviembre de 2025" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Duración (minutos)</label>
                    <input type="text" placeholder="Ej: 30" />
                </div>

                <div class="form-group wide">
                    <label>Puntaje (%)</label>
                    <input type="text" placeholder="0-100" />
                </div>

                <div class="form-group wide">
                    <label>Observaciones *</label>
                    <textarea placeholder="Describe el comportamiento, dificultades, avances observados durante la sesión..."></textarea>
                </div>

                <div class="form-group wide">
                    <label>Logros y Recomendaciones</label>
                    <textarea placeholder="Logros alcanzados y recomendaciones para próximas sesiones..."></textarea>
                </div>

            </div>

            <!-- BOTONES -->
            <div class="btn-row">
                <button class="btn-cancel">Cancelar</button>
                <button class="btn-save"><i class="fas fa-save"></i> Registrar Progreso</button>
            </div>

        </div>

        <!-- LATERAL DERECHO -->
        <div class="side-panel">

            <!-- REGISTROS RECIENTES -->
            <div class="recent-box">
                <h3><i class="fas fa-history"></i> Registros Recientes</h3>
                <p class="desc">Últimas sesiones registradas</p>

                <div class="recent-item">
                    <h4>María García López</h4>
                    <p>Reconocimiento de Emociones</p>
                    <span class="date">10 Nov 2025</span>
                    <span class="percent green">88%</span>
                </div>

                <div class="recent-item">
                    <h4>Juan Pérez Martínez</h4>
                    <p>Números y Conteo</p>
                    <span class="date">11 Nov 2025</span>
                    <span class="percent green">92%</span>
                </div>

                <div class="recent-item">
                    <h4>Ana Martínez Ruiz</h4>
                    <p>Colores y Formas</p>
                    <span class="date">9 Nov 2025</span>
                    <span class="percent orange">75%</span>
                </div>

            </div>

            <!-- CONSEJOS -->
            <div class="tips-box">
                <h3>Consejos</h3>

                <ul>
                    <li>Sé específico en las observaciones</li>
                    <li>Registra tanto logros como dificultades</li>
                    <li>Incluye recomendaciones para la familia</li>
                    <li>Documenta cambios de comportamiento</li>
                </ul>
            </div>

        </div>

    </div>

</div>
