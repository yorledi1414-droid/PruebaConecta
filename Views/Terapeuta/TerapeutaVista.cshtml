@{
    ViewBag.Title = "Panel de Control - Terapeuta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Head {
    <link rel="stylesheet" href="~/Content/TerapeutaDashboard.css" />
}

<div class="terap-wrapper">

    <!-- Saludo -->
    <div class="header">
        <h1>¡Bienvenido, Dr. Roberto García!</h1>
        <p>Panel de Control - Terapeuta</p>

        <div class="top-actions">
            <a href="@Url.Action("ConfiguracionTerapeuta", "Terapeuta")" class="btn-top">
                <i class="fas fa-cog"></i> Configuración
            </a>

            <a href="@Url.Action("MiPerfilTerapeuta", "Terapeuta")" class="btn-top profile">
                <i class="fas fa-user"></i> Mi Perfil
            </a>

        </div>
    </div>

    <!-- Cuadro de indicadores -->
    <div class="stats-grid">
        <div class="stat-card">
            <p class="label">Total Pacientes</p>
            <h2>12</h2>
            <p class="sub">Activos actualmente</p>
            <i class="fas fa-user-friends icon blue"></i>
        </div>

        <div class="stat-card">
            <p class="label">Sesiones Hoy</p>
            <h2>5</h2>
            <p class="sub">3 completadas, 2 pendientes</p>
            <i class="fas fa-calendar-day icon purple"></i>
        </div>

        <div class="stat-card">
            <p class="label">Progreso Promedio</p>
            <h2>85%</h2>
            <p class="sub green">+5% esta semana</p>
            <i class="fas fa-chart-line icon green"></i>
        </div>

        <div class="stat-card">
            <p class="label">Mensajes Nuevos</p>
            <h2>8</h2>
            <p class="sub">De tutores</p>
            <i class="fas fa-comment icon orange"></i>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="quick-grid">

        <a href="@Url.Action("MisPacientes", "Terapeuta")" class="quick-card blue-card">
            <i class="fas fa-users"></i>
            <p>Mis Pacientes</p>
        </a>


        <a href="@Url.Action("RegistrarProgreso", "Terapeuta")" class="quick-card purple-card">
            <i class="fas fa-clipboard-list"></i>
            <p>Registrar Progreso</p>
        </a>


        <a href="@Url.Action("AgendaDeCitas", "Terapeuta")" class="quick-card">
            <i class="fas fa-calendar-alt"></i>
            <p>Agenda de Citas</p>
        </a>


        <a href="@Url.Action("Reportes", "Terapeuta")" class="quick-card purple-card">
            <i class="fas fa-chart-line"></i>
            <p>Reportes</p>
        </a>


        <a href="@Url.Action("MensajesTerapeuta", "Terapeuta")" class="quick-card cyan-card">
            <i class="fas fa-comment-dots"></i>
            <p>Mensajes</p>
        </a>

        <a href="@Url.Action("NotificacionesTerapeuta", "Terapeuta")" class="quick-card teal-card">
            <i class="fas fa-bell"></i>
            <p>Notificaciones</p>
        </a>

    </div>

</div>
