@{
    ViewBag.Title = "Juegos";
}


<div class="app-container">
    <!-- Aquí puedes agregar header si quieres -->
    <div class="main-content">
        <div class="juego-card">
            <img src="@Url.Content("~/Content/Images/Rompecabezas.png")" alt="Rompecabezas" class="juego-img" />
            <div class="juego-info">
                <h3>ROMPECABEZAS</h3>
                <span class="arrow">→</span>
            </div>
        </div>

        <div class="juego-card">
            <img src="@Url.Content("~/Content/Images/Memoria.png")" alt="Memoria" class="juego-img" />
            <div class="juego-info">
                <h3>MEMORIA</h3>
                <span class="arrow">→</span>
            </div>
        </div>
    </div>

    <!-- Navbar inferior -->
    <div class="footer-nav">
        <div class="nav-item active">
            <span class="icon">📅</span>
            <span>Mis Citas</span>
        </div>
        <div class="nav-item">
            <span class="icon">🎮</span>
            <span>Juegos</span>
        </div>
        <div class="nav-item">
            <span class="icon">✏️</span>
            <span>ExpresArte</span>
        </div>
        <div class="nav-item">
            <span class="icon">👤</span>
            <span>Mi Perfil</span>
        </div>
    </div>
</div>
