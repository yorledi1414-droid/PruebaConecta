@{
    ViewBag.Title = "Registro de Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.BodyClass = "registro-page";
}

@section Head {
    <link rel="stylesheet" href="~/Content/Registro.css" />
}

@if (TempData["Error"] != null)
{
    <div class="alerta-error">
        <p>@TempData["Error"]</p>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.body.classList.add("registro-page");
        });
    </script>
}

<div class="registro-container">
    <div class="registro-box">

        <h2 class="titulo">BIENVENIDO</h2>
        <p class="subtitulo">¿Eres?</p>

        @using (Html.BeginForm("Index", "Registro", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <!-- ROLES -->
            <div class="roles">
                <label><input type="radio" name="Rol" value="Administrador" required /> ADMINISTRADOR</label>
                <label><input type="radio" name="Rol" value="Terapeuta" /> TERAPEUTA</label>
                <label><input type="radio" name="Rol" value="Tutor" /> TUTOR</label>
            </div>

            <!-- CAMPOS GENERALES -->
            <div id="camposGenerales">
                <div class="form-group"><label>Nombre</label><input type="text" name="Nombre" required /></div>
                <div class="form-group"><label>Apellido</label><input type="text" name="Apellido" required /></div>
                <div class="form-group"><label>Correo electrónico</label><input type="email" name="Email" required /></div>
                <div class="form-group"><label>Contraseña</label><input type="password" name="Password" required /></div>
            </div>

            <!-- CAMPOS TERAPEUTA -->
            <div id="camposTerapeuta" class="oculto">
                <div class="form-group">
                    <label>Tipo de documento</label>
                    <label><input type="radio" name="TipoDocumento_Terapeuta" value="Ciudadanía" checked /> Ciudadanía</label>
                    <label><input type="radio" name="TipoDocumento_Terapeuta" value="Extranjera" /> Extranjera</label>
                </div>

                <div class="form-group"><label>Número de documento</label><input type="text" name="NumeroDocumento_Terapeuta" /></div>
                <div class="form-group"><label>Profesión</label><input type="text" name="Profesion" /></div>
                <div class="form-group"><label>Especialidad</label><input type="text" name="Especialidad" /></div>
                <div class="form-group"><label>Certificado profesional</label><input type="file" name="CertificadoProfesion" /></div>
            </div>

            <!-- CAMPOS TUTOR -->
            <div id="camposTutor" class="oculto">
                <div class="form-group">
                    <label>Tipo de documento</label>
                    <label><input type="radio" name="TipoDocumento_Tutor" value="Ciudadanía" checked /> Ciudadanía</label>
                    <label><input type="radio" name="TipoDocumento_Tutor" value="Extranjera" /> Extranjera</label>
                </div>

                <div class="form-group"><label>Número de documento</label><input type="text" name="NumeroDocumento_Tutor" /></div>
                <div class="form-group"><label>Dirección</label><input type="text" name="Direccion_Tutor" /></div>
                <div class="form-group"><label>Documento de cédula</label><input type="file" name="CedulaTutor" /></div>
            </div>

            <button type="submit" class="btn-guardar">Guardar</button>
        }
    </div>
</div>

<!-- ============================= -->
<!--   SCRIPT DE CAMBIO DE ROLES   -->
<!-- ============================= -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radios = document.querySelectorAll("input[name='Rol']");
            const camposTerapeuta = document.getElementById("camposTerapeuta");
            const camposTutor = document.getElementById("camposTutor");

            function actualizarCampos() {
                const rolSeleccionado = document.querySelector("input[name='Rol']:checked");
                if (!rolSeleccionado) return;

                if (rolSeleccionado.value === "Terapeuta") {
                    camposTerapeuta.style.display = "block";
                    camposTutor.style.display = "none";
                } else if (rolSeleccionado.value === "Tutor") {
                    camposTerapeuta.style.display = "none";
                    camposTutor.style.display = "block";
                } else {
                    camposTerapeuta.style.display = "none";
                    camposTutor.style.display = "none";
                }
            }

            // Aplica cuando el usuario cambia de rol
            radios.forEach(r => r.addEventListener("change", actualizarCampos));

            // Aplica también al cargar por si hay validaciones o errores
            actualizarCampos();
        });
    </script>
}




















