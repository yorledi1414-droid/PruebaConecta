
@{
    ViewBag.Title = "MiPerfil";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi perfil</title>
    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(to bottom, #81c7f5, #c2a6f9);
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100vh;
        }

        h1 {
            text-align: center;
            color: white;
            font-size: 2.5rem;
            margin-top: 40px;
            margin-bottom: 20px;
        }

        .perfil-container {
            background-color: rgba(255, 255, 255, 0.25);
            border: 2px solid rgba(255, 255, 255, 0.5);
            border-radius: 15px;
            padding: 20px 40px;
            width: 50%;
            max-width: 700px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .perfil-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #6eaee8;
            border-radius: 8px;
            padding: 15px 20px;
            color: white;
            font-size: 1.1rem;
            transition: 0.3s;
        }

            .perfil-item:hover {
                background-color: #5da0e0;
                cursor: pointer;
            }

            .perfil-item i {
                margin-right: 10px;
            }

        .bottom-menu {
            position: absolute;
            bottom: 20px;
            display: flex;
            justify-content: center;
            gap: 30px;
            width: 100%;
        }

            .bottom-menu a {
                background-color: rgba(255, 255, 255, 0.3);
                padding: 10px 20px;
                border-radius: 10px;
                color: white;
                text-decoration: none;
                font-weight: bold;
            }

                .bottom-menu a.active {
                    background-color: rgba(255, 255, 255, 0.6);
                }
    </style>
</head>
<body>

    <h1>Mi perfil</h1>

    <div class="perfil-container">
        <div class="perfil-item"><i>👤</i> Editar información <span>›</span></div>
        <div class="perfil-item"><i>🔔</i> Notificaciones <span>›</span></div>
        <div class="perfil-item"><i>❓</i> Conoce sobre nosotros <span>›</span></div>
        <div class="perfil-item"><i>🔒</i> Privacidad <span>›</span></div>
        <div class="perfil-item"><i>🚪</i> Cerrar Sesión <span>›</span></div>
        <div class="perfil-item"><i>🗑️</i> Borrar Cuenta <span>›</span></div>
    </div>

    <div class="bottom-menu">
        <a href="#">Citas Programadas</a>
        <a href="#">Mis horarios</a>
        <a href="#" class="active">Mi Perfil</a>
    </div>

</body>
</html>
