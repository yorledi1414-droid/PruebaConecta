
@{
    ViewBag.Title = "Configuraciones";
}



<link rel="stylesheet" href="~/css/Herramientas.css" />

<div class="herramientas-container">
    <div class="header">
        <div class="back-icon">←</div>
        <h1>Herramientas</h1>
        <div class="settings-icon">⚙️</div>
    </div>

    <div class="section">
        <h2>Control de sonido y notificaciones</h2>
        <div class="card">
            <button class="item">
                <span class="icon">🔇</span>
                <p>Silenciar notificaciones (mute total temporal).</p>
                <span class="arrow">➜</span>
            </button>
            <button class="item">
                <span class="icon">🔊</span>
                <p>Subir/bajar volumen de alertas (independiente del volumen)</p>
                <span class="arrow">➜</span>
            </button>
            <button class="item">
                <span class="icon">🔔</span>
                <p>Activar/desactivar recordatorios de citas.</p>
                <span class="arrow">➜</span>
            </button>
            <button class="item">
                <span class="icon">🎵</span>
                <p>Tono de notificación</p>
                <span class="arrow">➜</span>
            </button>
        </div>
    </div>

    <div class="section">
        <h2>Personalización de la interfaz</h2>
        <div class="card">
            <button class="item">
                <span class="icon">🌙</span>
                <p>Modo oscuro / claro.</p>
                <span class="arrow">➜</span>
            </button>
            <button class="item">
                <span class="icon">🅰️</span>
                <p>Tamaño de fuente</p>
                <span class="arrow">➜</span>
            </button>
            <button class="item">
                <span class="icon">🎨</span>
                <p>Contraste / accesibilidad</p>
                <span class="arrow">➜</span>
            </button>
        </div>
    </div>
</div>
