@{
    ViewBag.Title = "Editar Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/Content/OjoLogo.css" />
}

<div class="modal-editar">
    <div class="modal-contenido">
        <div class="modal-header">
            <h3>Editar Perfil</h3>
            <span class="cerrar" onclick="window.location.href='@Url.Action("GestionUsuarios", "Admin")'">&times;</span>
        </div>

        <form>
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" value="Usuario Demo" />

            <label for="email">Email</label>
            <input type="email" id="email" value="usuario@ejemplo.com" />

            <label for="telefono">Teléfono</label>
            <input type="text" id="telefono" value="+1 234 567 8900" />

            <label for="ubicacion">Ubicación</label>
            <input type="text" id="ubicacion" value="Ciudad, País" />

            <button type="submit" class="btn-guardar">Guardar Cambios</button>
        </form>
    </div>
</div>



