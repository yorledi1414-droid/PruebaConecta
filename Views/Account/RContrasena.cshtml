@{
    ViewBag.Title = "Recuperar Contraseña";
}


@section Head {
    <link rel="stylesheet" href="~/Content/RContrasena.css" />
}

<div class="recover-page">
    <!-- Encabezado superior -->
    <header class="recover-header">
        <!-- Botón de regreso -->
        <button class="back" onclick="window.history.back()" title="Volver">
            <i class="fa-solid fa-arrow-left"></i>
        </button>

        <h2>Recuperar Contraseña</h2>

        <!-- Botón de configuración -->
        <button class="settings" title="Configuración">
            <i class="fa-solid fa-gear"></i>
        </button>
    </header>

    <!-- Tarjeta blanca principal -->
    <div class="recover-card">
        <h3>Recuperar Contraseña</h3>
        <p class="recover-sub">
            Ingresa tu correo registrado para recuperar tu contraseña.
        </p>

        <!-- 🔥 FORMULARIO CORREGIDO -->
        @using (Html.BeginForm("RContrasena", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken() <!-- 🔥 NECESARIO -->

            <div class="input-row">
                <span class="icon">
                    <i class="fa-solid fa-envelope"></i>
                </span>

                <!-- 🔥 CAMBIADO A name="email" -->
                <input type="email" name="email" placeholder="Correo electrónico" required />
            </div>

            <div class="actions">
                <button type="submit" class="btn-send">Enviar</button>
                <button type="button" class="btn-cancel" onclick="window.history.back()">Cancelar</button>
            </div>

            <p class="note">
                Recibirás un correo con instrucciones para restablecer tu contraseña.
            </p>
        }
    </div>

</div>

@section Scripts {
    <script>
        function cerrarModal() {
            document.getElementById("modalConfirm").style.display = "none";
        }

        function confirmarEnvio() {
            alert("Correo enviado correctamente.");
            cerrarModal();
        }
    </script>
}
