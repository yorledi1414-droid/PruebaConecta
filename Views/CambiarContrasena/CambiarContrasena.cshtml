@{
    ViewBag.Title = "Cambiar Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/Content/CambiarContrasena.css" />
    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            input.type = input.type === "password" ? "text" : "password";
        }
    </script>
}

<div class="cambiar-container">
    <a href="@Url.Action("Home", "Home")" class="btn-volver"><i class="fas fa-arrow-left"></i> Volver</a>

    <div class="formulario">
        <div class="icono-lock">
            <i class="fas fa-lock"></i>
        </div>
        <h2>Cambiar Contraseña</h2>

        @if (ViewBag.Error != null)
        {
            <p style="color:#e74c3c; text-align:center;">@ViewBag.Error</p>
        }

        <form method="post" action="@Url.Action("CambiarContrasena", "Account")">
            <label for="nueva">Nueva Contraseña</label>
            <div class="campo-password">
                <i class="fas fa-lock"></i>
                <input type="password" id="nueva" name="nueva" placeholder="Nueva contraseña" required />
                <i class="fas fa-eye" onclick="togglePassword('nueva')"></i>
            </div>

            <label for="confirmar">Confirmar Contraseña</label>
            <div class="campo-password">
                <i class="fas fa-lock"></i>
                <input type="password" id="confirmar" name="confirmar" placeholder="Confirma tu contraseña" required />
                <i class="fas fa-eye" onclick="togglePassword('confirmar')"></i>
            </div>

            <button type="submit" class="btn-actualizar">ACTUALIZAR CONTRASEÑA</button>
        </form>
    </div>
</div>

