@{
    ViewBag.Title = "Verificar Código";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <link rel="stylesheet" href="~/Content/VerificarContrasena.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <div class="verify-container">

        <a href="@Url.Action("RContrasena", "Account")" class="back-btn">← Volver</a>

        <div class="verify-card">

            <div class="icon-circle">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h2>Verificar Código</h2>

            <p class="msg">Hemos enviado un código de verificación a:</p>

            <p class="email">@ViewBag.Email</p>

            @if (ViewBag.Error != null)
            {
                <p style="color:#e74c3c; text-align:center;">@ViewBag.Error</p>
            }

            @using (Html.BeginForm("VerificarContrasena", "Account", FormMethod.Post))
            {
                <label class="label">Código de verificación</label>

                <input type="text"
                       name="codigo"
                       maxlength="6"
                       class="code-input"
                       placeholder="------"
                       autocomplete="off" />

                <p class="codigo-prueba">Código de prueba: 123456</p>

                <button type="submit" class="btn-verificar">
                    VERIFICAR CÓDIGO
                </button>
            }

            <a href="#" class="resend">Reenviar código</a>

        </div>
    </div>

</body>
</html>



